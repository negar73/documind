# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL with the pgvector extension (see docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/documind?schema=public"

# ── LLM / embedding provider ─────────────────────────────────────────────────
# Works with OpenAI or ANY OpenAI-compatible endpoint:
#   OpenAI : https://api.openai.com/v1
#   Ollama : http://localhost:11434/v1        (see README → "Using 100% local models")
#   Groq   : https://api.groq.com/openai/v1
#   Together: https://api.together.xyz/v1
OPENAI_API_KEY="sk-your-key-here"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Models (chat + embeddings). If you switch providers, adjust both names and
# keep EMBEDDING_DIM in sync with the vector column in prisma/schema.prisma.
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM="1536"

# ── RAG tuning ───────────────────────────────────────────────────────────────
# Maximum characters per chunk ( CHUNK_OVERLAP must be < CHUNK_SIZE ).
CHUNK_SIZE="1000"
CHUNK_OVERLAP="150"
# How many similar chunks to retrieve per question.
TOP_K="5"
